{
  "name": "highfos-treasure-hunter",
  "private": true,
  "version": "0.1.0",
  "description": "하이포스 방학 트레저 헌터 - 초등 영어·수학 학습 퀘스트 웹앱",
  "scripts": {
    "db:init": "wrangler d1 execute highfos-treasure-hunter --local --persist-to .local-db --file=schema.sql",
    "db:init:remote": "wrangler d1 execute highfos-treasure-hunter --remote --file=schema.sql",
    "dev": "wrangler dev --port 8787 --persist-to .local-db",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
